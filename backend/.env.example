PORT=5000
MONGODB_URI=mongodb://localhost:27017/wcms
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Email (for password reset) - use Gmail App Password or any SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=WebApps Club <your-email@gmail.com>

# Default super admin (created on first run)
SUPER_ADMIN_ID=SUPER001
SUPER_ADMIN_PASSWORD=SuperAdmin@123
SUPER_ADMIN_NAME=Super Admin
